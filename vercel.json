{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!.*\\.txt$|sitemap\\.xml|status\\.json|status\\.html|embed(?:/.*)?$|take-home-pay-by-country(?:/.*)?$|widget(?:/.*)?$|salary-widget(?:/.*)?$|uk-tax-changes-2027(?:/.*)?$|us-tax-changes-2027(?:/.*)?$|au-tax-changes-2027(?:/.*)?$).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/us",
      "destination": "/us-tools/",
      "permanent": true
    },
    {
      "source": "/uk",
      "destination": "/uk-tools/",
      "permanent": true
    },
    {
      "source": "/au",
      "destination": "/au-tools/",
      "permanent": true
    },
    {
      "source": "/us/",
      "destination": "/us-tools/",
      "permanent": true
    },
    {
      "source": "/uk/",
      "destination": "/uk-tools/",
      "permanent": true
    },
    {
      "source": "/au/",
      "destination": "/au-tools/",
      "permanent": true
    }
  ]
}
